{
  "name": "localcaddyhub",
  "version": "1.0.0",
  "description": "LocalCaddyHub Node.js API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-skip-pattern=^proxy: tests/*.test.js tests/*.test.cjs",
    "test:runtime": "node --test tests/runtime.test.cjs",
    "test:proxy": "node --test tests/proxy.test.cjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.1",
    "multer": "^2.5.0",
    "otplib": "^13.3.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
